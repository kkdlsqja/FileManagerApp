<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. 앱이 인터넷을 사용할 수 있도록 권한 부여 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="FileManagerApp"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:usesCleartextTraffic="true"> <!-- 2. 로컬 서버(http) 통신 허용 -->

        <!-- 3. 앱을 켰을 때 가장 먼저 실행될 화면: LoginActivity -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 4. 로그인 성공 후 넘어갈 화면: MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 5. 새롭게 추가한 회원가입 화면: SignupActivity -->
        <activity
            android:name=".SignupActivity"
            android:exported="false" />

        <activity
            android:name=".FileListActivity"
            android:exported="false"
            />

        <activity
            android:name=".FileHistoryActivity"
            android:exported="false" />

    </application>

</manifest>
